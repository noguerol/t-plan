# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Local pi project config
.pi/

# Generated plan files (runtime output of the t-plan extension) — PRIVATE,
# never commit or publish them. One unified file per project:
# <prefix>_<title-slug>.md (no session id). The pattern also covers the
# legacy session-scoped names (plan_<title>_<session-id>.md).
plan.md
plan_*.md

# punched-memory — never commit project-local memory
pi.md
pi.md.local
.punched-memory.json
.punched-memory/
# t-plan: plan files are private runtime state — never commit or publish them
plan_*_[0-9a-zA-Z]*.md
